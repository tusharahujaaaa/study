function countChar(str) {
    let temp = []
    for (let i = 0; i < str.length; i++) {
        const exist = temp.some(obj => obj.key == str[i]);
        const obj = temp.find(item => item.key === str[i]);
        if (obj) {
            obj.value += 1
        } else {
            temp.push({ key: str[i], value: 1 })
        }
    }
